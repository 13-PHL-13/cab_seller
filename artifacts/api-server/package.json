{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --use-system-ca --env-file-if-exists=.env --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --experimental-strip-types --test src/lib/auth.test.ts src/lib/marketplace-finance.test.ts src/lib/ozon-performance.test.ts src/lib/marketplace-access.test.ts src/lib/task-policy.test.ts src/lib/ai-balance.test.ts src/lib/dashboard-layout.test.ts src/lib/task-block.test.ts",
    "seed:cogs:test": "node --experimental-strip-types --env-file-if-exists=.env ./scripts/seed-cogs-test-data.ts"
  },
  "dependencies": {
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "drizzle-orm": "catalog:",
    "express": "^5.3.0",
    "multer": "^2.5.0",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "catalog:",
    "esbuild": "0.28.2",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.2.0",
    "thread-stream": "3.1.0"
  }
}
