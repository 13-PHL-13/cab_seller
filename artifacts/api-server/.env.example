# Copy to the API server environment. Never commit real values.
NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://user:password@localhost:5432/cab_seller
APP_ORIGIN=http://localhost:4173
SESSION_TTL_DAYS=30

# Used to encrypt marketplace API credentials already stored by the app.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=replace-with-a-long-random-secret

# SMTP over implicit TLS (port 465)
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=replace-me
SMTP_PASSWORD=replace-me
SMTP_FROM=noreply@example.com
